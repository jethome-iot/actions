ACTION_DIR="armbian-version"
STEP_ID="copyversion"

export INPUT_PATHOS="os"
export INPUT_PATHARMBIAN="build"
export INPUT_BETA="yes"

# Шаг читает json'ы через настоящий jq и пишет VERSION. Готовим песочницу.
mkdir -p "${SANDBOX}/os" "${SANDBOX}/build"
echo '{"version": "25.11.1"}' >"${SANDBOX}/os/nightly.json"
# Три поля, а не два, как в настоящем *-jethome.json: шаг берёт третье поле
# через xargs printf, а на пустом вводе GNU xargs печатает 00, BSD — ничего.
# С двумя полями эталон зависел бы от платформы.
echo '{"version": "0.6.3"}' >"${SANDBOX}/os/nightly-jethome.json"
cd "${SANDBOX}" || exit 1

RESULT_FILES=(build/VERSION)
