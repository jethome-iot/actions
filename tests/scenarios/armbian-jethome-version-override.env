ACTION_DIR="armbian-jethome-version"
STEP_ID="setversion"

echo '{"version": "1.7"}' >"${SANDBOX}/nightly-jethome.json"
cd "${SANDBOX}" || exit 1

export INPUT_FILE="nightly-jethome.json"
export INPUT_TYPE="minor"
export INPUT_DO="inc"
export INPUT_OVERRIDE="9.9"

# Результат шага — сам json: github_output несёт литерал из-за одинарных кавычек.
RESULT_FILES=(nightly-jethome.json)
